# Docker Compose
DB_NAME=mydata_card
DB_USERNAME=mydata_app
DB_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PORT=3307

# Spring Boot
DB_URL='jdbc:mysql://127.0.0.1:3307/mydata_card?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul'

# JWT Access Token (Base64 DER: public=X.509, private=PKCS#8)
# Generate local-only values by following docs/jwt-authentication.md.
JWT_PUBLIC_KEY_BASE64=replace-with-local-x509-public-key
JWT_PRIVATE_KEY_BASE64=replace-with-local-pkcs8-private-key
JWT_ISSUER=https://mydata-card-recommendation.local
JWT_AUDIENCE=mydata-card-recommendation-clients
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_KEY_ID=local-primary
